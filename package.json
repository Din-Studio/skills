{
  "name": "echojoy-skills",
  "version": "0.2.0",
  "private": true,
  "description": "EchoJoy's portable agent skills for Claude Code, Codex, and other agents.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Din-Studio/skills.git"
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "sync": "node scripts/sync-lingying.mjs && node scripts/manifests.mjs sync",
